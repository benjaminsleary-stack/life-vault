# Secrets for the scripts. On the DESKTOP bridge, source this (or export these) so
# notify.sh can alert. In the CLOUD routine environment, set these as Environment
# Variables in the environment config — NEVER in a routine prompt (spec §6).
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx      # Google app password (needs 2FA)
ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics   # private read-only

# Calendars the DASHBOARD subscribes to (Agenda card). Private .ics URLs are
# credentials — anyone holding one can read the calendar. Locally these live in
# .env (gitignored); deployed they are Worker secrets:
#   cd worker && npx wrangler secret put CAL_WORK
CAL_WORK=https://outlook.office365.com/owa/calendar/<id>/<token>/calendar.ics
CAL_PERSONAL=https://calendar.google.com/calendar/ical/.../basic.ics
CAL_FAMILY=https://calendar.google.com/calendar/ical/<family-id>/private-<token>/basic.ics
# Google Calendar WRITE access — the only credential here that can create events
# (CAL_* above are read-only subscriptions). Optional: without it, family-events
# writes its digest and an .ics and says so. Setup: docs/google-calendar.md.
GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<secret>
GOOGLE_REFRESH_TOKEN=<refresh token from scripts/google-auth.mjs>
GOOGLE_CALENDAR_ID=<...>@group.calendar.google.com   # the family calendar, not "primary"

# Runs. The Garmin watch auto-syncs to Strava and the vault reads Strava —
# Garmin has no free personal API. Optional. Setup: docs/strava.md.
STRAVA_CLIENT_ID=<numeric id from strava.com/settings/api>
STRAVA_CLIENT_SECRET=<secret>
STRAVA_REFRESH_TOKEN=<refresh token from scripts/strava-auth.mjs, activity:read_all>

# Delivery. Briefings go out as the vault's OWN Web Push, via the Worker, so
# these two are what notify.sh needs. There is no ntfy any more.
WORKER_URL=https://life-vault.benvault.workers.dev
UNLOCK_TOKEN=<the same shared secret the app unlocks with>
HEALTHCHECK_URL=https://hc-ping.com/<uuid>   # healthchecks.io ping (silence = alarm)
# MAIL_SINCE_HOURS=24
